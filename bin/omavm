#!/bin/bash
#
# omavm - drive the disposable Omarchy test VM from one command.
#
# Every VM is a libvirt domain on qemu:///system, so it runs without a window,
# shows up in anything that lists libvirt machines (the bar's VM panel,
# virt-manager) and opens in virt-viewer when you want to look at it. A VM's
# disk is a thin overlay on a snapshot, so booting a clean one copies nothing.
# This script wraps booting, SSH, file transfer, screenshots, Hyprland and
# quickshell access and plugin installs so nothing has to remember the
# env-var and gum-confirm pitfalls.

set -euo pipefail

# libvirt's own images directory, so the qemu that libvirt starts can read the
# disks. Create it once (see the README); everything after that runs as you.
IMAGES_DIR="${OMAVM_IMAGES_DIR:-/var/lib/libvirt/images/omavm}"
SNAPSHOTS_DIR="$IMAGES_DIR/snapshots"
# OMAVM_NAME runs a second VM next to the default one: its own domain, disk
# and firmware vars.
NAME="${OMAVM_NAME:+-$OMAVM_NAME}"
DOMAIN="omavm$NAME"
DISK="$IMAGES_DIR/$DOMAIN.qcow2"
VARS="$IMAGES_DIR/$DOMAIN-vars.fd"
VM_MEM="${OMAVM_MEM:-8192}"  # MB
VM_CPUS="${OMAVM_CPUS:-8}"
# There is no window for the guest to take its size from, so it gets one.
VM_RES="${OMAVM_RES:-1920x1200}"
OVMF_CODE=/usr/share/edk2/x64/OVMF_CODE.4m.fd
VIRSH=(virsh -c qemu:///system)
GUEST_USER="${OMAVM_USER:-$USER}"
GUEST_UID=1000
SHELL_QML="/usr/share/omarchy/shell/shell.qml"

# Unattended install settings. The guest deliberately has no disk encryption:
# it is a throwaway machine that must boot straight into Hyprland without
# anyone typing a passphrase. Nothing secret may live on that disk; secrets
# reach the guest over a forwarded SSH agent instead (see cmd_agent).
# Empty means the newest omarchy-*.iso in ~/Downloads (see find_iso), so a new
# release needs no change here.
ISO="${OMAVM_ISO:-}"
GUEST_PASSWORD="${OMAVM_PASSWORD:-omarchy}"
GUEST_HOSTNAME="${OMAVM_HOSTNAME:-omarchy-vm}"
GUEST_TIMEZONE="${OMAVM_TIMEZONE:-Europe/Amsterdam}"
# Git identity for the guest; taken from yours so a fresh VM commits as you.
GUEST_FULL_NAME="${OMAVM_FULL_NAME:-$(git config --global user.name 2>/dev/null || echo "$USER")}"
GUEST_EMAIL="${OMAVM_EMAIL:-$(git config --global user.email 2>/dev/null || echo "$USER@localhost")}"
# The host agent that holds the real keys; forwarded on demand, never copied.
AGENT_SOCK="${OMAVM_AGENT_SOCK:-$HOME/.1password/agent.sock}"
# Stow packages installed into the guest. Left out on purpose: "ssh" (its
# IdentityAgent line would override the forwarded agent), "services" (timers
# that would start backing up and syncing from a test VM) and the app-specific
# packages that have nothing to configure there.
DOTFILES_PACKAGES="${OMAVM_DOTFILES_PACKAGES:-ai hypr omarchy-managed omarchy-overrides personal scripts}"
DOTFILES_REPO="${OMAVM_DOTFILES_REPO:-$HOME/dotfiles}"
# The guest gets a clone of your working copy, so point its origin back at
# wherever yours came from rather than at a path on this machine.
DOTFILES_ORIGIN="${OMAVM_DOTFILES_ORIGIN:-$(git -C "$DOTFILES_REPO" remote get-url origin 2>/dev/null || true)}"

# Every boot gets a new host key from the snapshot's point of view, and the
# address comes from DHCP, so pinning either would only produce warnings.
SSH_OPTS=(-o ConnectTimeout=3 -o StrictHostKeyChecking=no
  -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR)
# Session env for tools that need the guest's Wayland/Hyprland session, read
# from the user's systemd manager, which the session imports its environment
# into. Guessing it goes wrong: a Hyprland that crashed or was restarted
# leaves its old instance dir in /run/user/<uid>/hypr, and those names sort
# oldest first.
GUEST_ENV="export XDG_RUNTIME_DIR=/run/user/$GUEST_UID; eval \"\$(runuser -u $GUEST_USER -- \
systemctl --user show-environment 2>/dev/null | sed -n -E \
's/^(WAYLAND_DISPLAY|HYPRLAND_INSTANCE_SIGNATURE|DBUS_SESSION_BUS_ADDRESS)=/export &/p')\";"

usage() {
  cat <<'USAGE'
omavm - drive the disposable Omarchy test VM

Usage: omavm <command> [args]

Every VM is a libvirt domain ("omavm", or "omavm-<name>" with OMAVM_NAME) on
qemu:///system. It runs without a window; "omavm view" or the bar's VM panel
opens its screen.

Building the machine (rarely; "fresh" is already built):
  install              Install Omarchy from scratch, unattended, onto a blank
                       disk, from the newest omarchy-*.iso in ~/Downloads
                       (or OMAVM_ISO). Uses a cidata drive so nothing has to
                       be typed, and installs WITHOUT disk encryption so the
                       VM boots straight into Hyprland. Runs provision
                       afterwards.
                       Save the result with: omavm stop && omavm save fresh
  provision            Re-run the post-install steps on a running VM: root SSH
                       key, passwordless sudo, pacman -Sy, and the dotfiles
                       when there is a repo for them (OMAVM_DOTFILES_REPO,
                       default ~/dotfiles).
  dotfiles             Re-copy the host dotfiles into the guest and stow them
                       (installs stow first).

VM lifecycle:
  boot [snapshot]      Boot a clean VM from a snapshot (default: fresh). Its
                       disk is a thin overlay on the snapshot, so this copies
                       nothing; a previous disk of the same VM is discarded.
                       Waits until SSH answers.
  create <name> [snapshot]
                       The same for a VM named omavm-<name>, printing
                       "<domain><TAB><ip>" for scripts to read.
  resume               Start the VM again from its existing disk (continue
                       where a stopped VM left off).
  stop                 Shut the VM down cleanly (poweroff over SSH, ACPI
                       without SSH, then forced after 30s).
                       The disk stays for "resume".
  destroy              Stop the VM and remove its domain and disk.
  status               Show state, address, SSH and whether a Hyprland
                       session is running in the guest.

Snapshots (in /var/lib/libvirt/images/omavm/snapshots):
  save <name> [--force]
                       Save the VM's disk as a standalone snapshot. Refuses
                       while the VM is running: stop it first for a
                       consistent copy. Refuses to overwrite an existing
                       snapshot without --force, so "fresh" cannot go by
                       accident, and refuses outright while a VM's disk
                       still builds on it.
  list                 List snapshots and omavm VMs.

Working in the guest (root over SSH on the VM's address):
  ssh [cmd...]         Open a shell in the VM, or run a single command.
  user <cmd...>        Run a command in the guest as the regular user, with
                       the Wayland/Hyprland session environment loaded.
  push <local> [dest]  Copy a file or directory into the VM (default /tmp/).
  pull <remote> [dest] Copy a file out of the VM (default: current dir).
  agent [cmd...]       Shell or command as the guest user with your host SSH
                       agent forwarded, so git and gh reach GitHub with your
                       real key. The key itself never enters the VM: the guest
                       can only ask the agent to sign, and only while this
                       command runs. Needs 1Password unlocked.
                         omavm agent git -C ~/dotfiles push
  ip                   Print the VM's address.

Desktop in the guest:
  view                 Open the VM's screen in virt-viewer. Closing the
                       viewer leaves the VM running.
  shot [file]          Take a screenshot of the guest desktop with grim and
                       write it to <file> (default: ./vm-shot.png). Needs SSH
                       and a running Hyprland session in the guest.
  screendump [file]    Photograph the guest's screen through libvirt
                       (default: ./vm-screen.png). Works without SSH and
                       without a desktop in the guest.
  sendkey <key...>     Press keys inside the guest via QEMU, e.g.
                         omavm sendkey ret
                         omavm sendkey ctrl-alt-f2
                       QEMU key names; dashes make a chord. This never touches
                       the host desktop, so it is safe while you work.
  hypr <args...>       Run hyprctl in the guest session. Remember: Quattro,
                       so dispatch takes lua, e.g.
                         omavm hypr dispatch 'hl.dsp.focus({ workspace = 2 })'
  qs <args...>         Run quickshell CLI against the running shell, e.g.
                         omavm qs ipc call your-name.text-transform open
  restart-shell        Restart omarchy-shell in the guest.
  resolution <WxH> [scale]
                       Set the guest's resolution for this session, e.g.
                         omavm resolution 2560x1600
                       OMAVM_RES sets it from the start (default 1920x1200).

Plugin testing:
  plugin <dir>         Install a local plugin directory into the guest:
                       copies it to ~/.config/omarchy/plugins/, registers the
                       bar widget from manifest.json in shell.json and
                       restarts the shell. Typical loop:
                         omavm boot && omavm plugin ~/Documents/OmarchyPlugins/foo && omavm shot

Settings: OMAVM_NAME, OMAVM_MEM (MB, 8192), OMAVM_CPUS (8), OMAVM_RES.

Notes:
  - The guest has no disk encryption and passwordless sudo, so treat its disk
    as readable by anyone who gets at it: never put a secret in the VM. Use
    "omavm agent" when something in there needs one of your keys.
  - If SSH does not come up after boot, look with "omavm screendump": the
    guest is usually waiting at a prompt.
USAGE
}

virsh_() { "${VIRSH[@]}" "$@"; }

domain_exists() { virsh_ dominfo "$DOMAIN" >/dev/null 2>&1; }
domain_running() { [[ $(virsh_ domstate "$DOMAIN" 2>/dev/null) == running ]]; }

# The address the default network's DHCP handed out. Looked up once per run.
IP=""
lookup_ip() {
  virsh_ domifaddr "$DOMAIN" --source lease 2>/dev/null |
    awk '/ipv4/ { split($4, a, "/"); ip = a[1] } END { print ip }'
}

require_running() {
  if ! domain_running; then
    echo "omavm: $DOMAIN is not running (start it with: omavm boot)" >&2
    exit 1
  fi
  [[ -n $IP ]] || IP=$(lookup_ip)
  if [[ -z $IP ]]; then
    echo "omavm: $DOMAIN has no address yet; it may still be booting." >&2
    exit 1
  fi
}

vmssh() { ssh "${SSH_OPTS[@]}" "root@$IP" "$@"; }

# The install puts our key on the guest user, not root, so first contact is as
# the user; cmd_provision then opens the root path the rest of omavm uses.
usermssh() { ssh "${SSH_OPTS[@]}" "$GUEST_USER@$IP" "$@"; }

# Wait for an address and then for SSH as <login> (root, or the guest user
# right after an install). Prints dots, and a minute marker on long waits.
wait_for_ssh() {
  local login="$1" timeout="${2:-180}" step="${3:-3}" waited=0
  echo -n "Waiting for SSH" >&2
  until [[ -n $IP ]] && ssh "${SSH_OPTS[@]}" "$login@$IP" true 2>/dev/null; do
    sleep "$step"
    waited=$((waited + step))
    [[ -n $IP ]] || IP=$(lookup_ip)
    echo -n "." >&2
    ((waited % 60 == 0)) && echo -n " ${waited}s" >&2
    if ((waited >= timeout)); then
      echo >&2
      echo "omavm: no SSH after ${timeout}s. Look at the screen with" >&2
      echo "'omavm screendump' or 'omavm view': it is probably at a prompt." >&2
      exit 1
    fi
  done
  echo " up on $IP after ~${waited}s" >&2
}

# Remove the domain and its disk. The firmware vars go with --nvram.
remove_domain() {
  virsh_ destroy "$DOMAIN" >/dev/null 2>&1 || true
  virsh_ undefine "$DOMAIN" --nvram >/dev/null 2>&1 || true
  rm -f "$DISK" "$VARS"
}

# Define and start the domain on an existing disk and vars. Plain virtio video
# with SPICE: no GPU acceleration, but libvirt can then photograph the screen
# (screendump), and virt-viewer opens it whenever someone wants to look.
define_domain() {
  local extra=("$@")
  virt-install --connect qemu:///system \
    --name "$DOMAIN" \
    --osinfo archlinux \
    --machine q35 \
    --memory "$VM_MEM" \
    --vcpus "$VM_CPUS" \
    --cpu host-passthrough \
    --boot "loader=$OVMF_CODE,loader.readonly=yes,loader.type=pflash,nvram=$VARS" \
    --network network=default,model=virtio \
    --graphics spice \
    --video virtio \
    --xml "./devices/video/model/resolution/@x=${VM_RES%x*}" \
    --xml "./devices/video/model/resolution/@y=${VM_RES#*x}" \
    --channel spicevmc \
    --noautoconsole \
    "${extra[@]}" >/dev/null
}

check_host() {
  if [[ ! -d $IMAGES_DIR || ! -w $IMAGES_DIR ]]; then
    echo "omavm: $IMAGES_DIR is missing or not writable. Create it once with:" >&2
    echo "  sudo install -d -o $USER -g libvirt -m 2775 $IMAGES_DIR" >&2
    exit 1
  fi
  # Captured first: grep -q stops reading early, and under pipefail the
  # SIGPIPE that gives virsh would count as the network being down.
  local net
  net=$(virsh_ net-info default 2>/dev/null || true)
  if [[ ! $net =~ Active:[[:space:]]+yes ]]; then
    echo "omavm: libvirt's default network is not running:" >&2
    echo "  sudo virsh net-autostart default && sudo virsh net-start default" >&2
    exit 1
  fi
}

cmd_boot() {
  local snapshot="${1:-fresh}"
  check_host
  if domain_running; then
    echo "omavm: $DOMAIN is already running; use it, or 'omavm stop' first." >&2
    exit 1
  fi
  if [[ ! -f "$SNAPSHOTS_DIR/$snapshot.qcow2" ]]; then
    echo "omavm: snapshot '$snapshot' not found" >&2
    cmd_list >&2
    exit 1
  fi
  remove_domain
  # The snapshot stays untouched: the VM writes only to its own overlay.
  qemu-img create -q -f qcow2 -b "$SNAPSHOTS_DIR/$snapshot.qcow2" -F qcow2 "$DISK"
  cp "$SNAPSHOTS_DIR/$snapshot-vars.fd" "$VARS"
  define_domain --import --disk "path=$DISK,format=qcow2,bus=virtio"
  echo "Booting $DOMAIN from snapshot '$snapshot' (${VM_MEM}MB, $VM_CPUS cores, ${VM_RES}, no window)" >&2
  wait_for_ssh root
}

cmd_create() {
  local name="${1:-}"
  if [[ ! $name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "omavm: usage: omavm create <name> [snapshot]   (lowercase, digits, dashes)" >&2
    exit 1
  fi
  OMAVM_NAME="$name" exec "$0" __create "${2:-fresh}"
}

cmd_resume() {
  check_host
  if domain_running; then
    echo "omavm: $DOMAIN is already running." >&2
    exit 1
  fi
  if ! domain_exists; then
    echo "omavm: there is no $DOMAIN to resume; boot a snapshot instead." >&2
    exit 1
  fi
  virsh_ start "$DOMAIN" >/dev/null
  echo "Resuming $DOMAIN from its existing disk" >&2
  wait_for_ssh root
}

cmd_stop() {
  if ! domain_running; then
    echo "omavm: $DOMAIN is not running."
    return 0
  fi
  # The ACPI shutdown is a press of the power button, and Omarchy answers that
  # with its system menu (logind ignores the key, Hyprland binds it), so on its
  # own it never powers the guest off. Ask over SSH first; ACPI is left for a
  # guest without SSH, still installing or at a prompt.
  IP=$(lookup_ip)
  if ! { [[ -n $IP ]] && vmssh "systemctl poweroff" >/dev/null 2>&1; }; then
    virsh_ shutdown "$DOMAIN" >/dev/null 2>&1 || true
  fi
  local waited=0
  while domain_running && ((waited < 30)); do
    sleep 1
    waited=$((waited + 1))
  done
  if domain_running; then
    virsh_ destroy "$DOMAIN" >/dev/null
    echo "$DOMAIN did not shut down within 30s; forced it off"
    return 0
  fi
  echo "$DOMAIN stopped"
}

cmd_destroy() {
  if ! domain_exists && [[ ! -e $DISK ]]; then
    echo "omavm: there is no $DOMAIN."
    return 0
  fi
  remove_domain
  echo "$DOMAIN destroyed"
}

# Open the screen in virt-viewer, in its own unit so it outlives the shell
# that asked for it. Closing it leaves the VM running.
cmd_view() {
  require_running
  systemd-run --user --collect --quiet --unit="omavm-view$NAME-$(date +%s)" \
    virt-viewer --connect qemu:///system --attach "$DOMAIN"
  echo "Opened $DOMAIN in virt-viewer; closing it leaves the VM running."
}

cmd_ip() {
  require_running
  echo "$IP"
}

cmd_status() {
  if ! domain_exists; then
    echo "domain:   $DOMAIN does not exist (omavm boot creates it)"
    return 0
  fi
  echo "domain:   $DOMAIN ($(virsh_ domstate "$DOMAIN" 2>/dev/null))"
  local backing
  backing=$(qemu-img info -U --output=json "$DISK" 2>/dev/null | jq -r '."backing-filename" // empty')
  [[ -f $DISK ]] && echo "disk:     $DISK ($(du -h "$DISK" | cut -f1)${backing:+ on $(basename "$backing" .qcow2)})"
  domain_running || return 0
  IP=$(lookup_ip)
  if [[ -n $IP ]] && vmssh true 2>/dev/null; then
    echo "ssh:      reachable (root@$IP)"
    if vmssh "ls /run/user/$GUEST_UID/hypr >/dev/null 2>&1"; then
      echo "hyprland: session running"
    else
      echo "hyprland: no session (look with omavm screendump or omavm view)"
    fi
  else
    echo "ssh:      not reachable${IP:+ on $IP}"
  fi
  echo "screen:   omavm view"
}

cmd_save() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "omavm: usage: omavm save <name> [--force]" >&2
    exit 1
  fi
  if domain_running; then
    echo "omavm: $DOMAIN is running; a snapshot of a live disk is inconsistent." >&2
    echo "Stop it first: omavm stop" >&2
    exit 1
  fi
  if [[ ! -f $DISK ]]; then
    echo "omavm: $DOMAIN has no disk to save." >&2
    exit 1
  fi
  local dest="$SNAPSHOTS_DIR/$name.qcow2"
  if [[ -f $dest && ${2:-} != "--force" ]]; then
    echo "omavm: snapshot '$name' already exists." >&2
    echo "Overwrite it with: omavm save $name --force" >&2
    exit 1
  fi
  # A disk that builds on the snapshot would be corrupted by overwriting it.
  # This VM's own disk is fine: it gets a fresh overlay on the new snapshot,
  # which has exactly the content it was saved from.
  local disk others=() own=false
  for disk in "$IMAGES_DIR"/*.qcow2; do
    [[ -f $disk ]] || continue
    [[ $(qemu-img info -U --output=json "$disk" 2>/dev/null | jq -r '."backing-filename" // empty') == "$dest" ]] || continue
    if [[ $disk == "$DISK" ]]; then own=true; else others+=("$(basename "$disk" .qcow2)"); fi
  done
  if ((${#others[@]} > 0)); then
    echo "omavm: these VMs build on snapshot '$name': ${others[*]}" >&2
    echo "Destroy them first: OMAVM_NAME=<name> omavm destroy" >&2
    exit 1
  fi
  # Flattened into a standalone image, so a snapshot never depends on another.
  mkdir -p "$SNAPSHOTS_DIR"
  qemu-img convert -O qcow2 "$DISK" "$dest.part"
  cp "$VARS" "$SNAPSHOTS_DIR/$name-vars.fd"
  mv -f "$dest.part" "$dest"
  chmod 664 "$dest" "$SNAPSHOTS_DIR/$name-vars.fd"
  if [[ $own == true ]]; then
    qemu-img create -q -f qcow2 -b "$dest" -F qcow2 "$DISK"
  fi
  echo "Saved snapshot '$name' ($(du -h "$dest" | cut -f1))"
}

cmd_list() {
  echo "Snapshots:"
  local f
  for f in "$SNAPSHOTS_DIR"/*.qcow2; do
    [[ -f $f ]] && printf '  %-20s %s\n' "$(basename "$f" .qcow2)" "$(du -h "$f" | cut -f1)"
  done
  echo "VMs:"
  virsh_ list --all --name 2>/dev/null | grep -E '^omavm(-|$)' | while read -r d; do
    printf '  %-20s %s\n' "$d" "$(virsh_ domstate "$d" 2>/dev/null)"
  done
}

cmd_ssh() {
  require_running
  if (($# == 0)); then
    exec ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "root@$IP"
  fi
  vmssh "$@"
}

cmd_user() {
  require_running
  if (($# == 0)); then
    echo "omavm: usage: omavm user <command...>" >&2
    exit 1
  fi
  # --preserve-environment keeps root's HOME, which makes every ~ in the
  # command point at /root; -w passes only the session vars we actually want.
  # runuser keeps the working directory, and root's is /root, which the user
  # cannot read: anything that looks at its cwd (find -exec ... +, say) fails.
  # So start in the user's home, as "omavm agent" does.
  vmssh "cd ~$GUEST_USER && $GUEST_ENV runuser -u $GUEST_USER \
    -w XDG_RUNTIME_DIR,WAYLAND_DISPLAY,HYPRLAND_INSTANCE_SIGNATURE -- bash -lc $(printf '%q' "$*")"
}

cmd_push() {
  require_running
  local src="${1:-}" dest="${2:-/tmp/}"
  if [[ -z "$src" ]]; then
    echo "omavm: usage: omavm push <local-path> [guest-dest]" >&2
    exit 1
  fi
  scp -r "${SSH_OPTS[@]}" "$src" "root@$IP:$dest"
}

cmd_pull() {
  require_running
  local src="${1:-}" dest="${2:-.}"
  if [[ -z "$src" ]]; then
    echo "omavm: usage: omavm pull <guest-path> [local-dest]" >&2
    exit 1
  fi
  scp -r "${SSH_OPTS[@]}" "root@$IP:$src" "$dest"
}

cmd_shot() {
  require_running
  local out="${1:-vm-shot.png}"
  vmssh "$GUEST_ENV grim /tmp/omavm-shot.png"
  vmssh "cat /tmp/omavm-shot.png" >"$out"
  vmssh "rm -f /tmp/omavm-shot.png"
  echo "$out"
}

cmd_hypr() {
  require_running
  local args
  printf -v args '%q ' "$@"
  vmssh "$GUEST_ENV hyprctl $args"
}

cmd_qs() {
  require_running
  local args
  printf -v args '%q ' "$@"
  vmssh "$GUEST_ENV runuser -u $GUEST_USER --preserve-environment -- qs -p $SHELL_QML $args"
}

cmd_restart_shell() {
  require_running
  vmssh "$GUEST_ENV runuser -u $GUEST_USER --preserve-environment -- omarchy restart shell"
  echo "Shell restarted"
}

cmd_plugin() {
  require_running
  local dir="${1:-}"
  if [[ -z "$dir" || ! -f "$dir/manifest.json" ]]; then
    echo "omavm: usage: omavm plugin <plugin-dir> (must contain manifest.json)" >&2
    exit 1
  fi
  local id name section
  id=$(jq -r '.id' "$dir/manifest.json")
  name=$(basename "$dir")
  section=$(jq -r '.barWidget.defaultSection // "right"' "$dir/manifest.json")

  echo "Installing $name ($id) into the guest"
  tar -C "$(dirname "$dir")" -czf - --exclude=.git --exclude=screenshots "$name" |
    vmssh "mkdir -p ~$GUEST_USER/.config/omarchy/plugins &&
           tar -C ~$GUEST_USER/.config/omarchy/plugins -xzf - &&
           chown -R $GUEST_USER:$GUEST_USER ~$GUEST_USER/.config/omarchy/plugins"

  # Register the bar widget in shell.json unless it is already there
  vmssh "cd ~$GUEST_USER/.config/omarchy &&
    if jq -e '.bar.layout.$section[] | select(.id == \"$id\")' shell.json >/dev/null 2>&1; then
      echo 'Widget already registered'
    else
      jq '.bar.layout.$section = [{\"id\": \"$id\"}] + .bar.layout.$section' shell.json > shell.json.new &&
      mv shell.json.new shell.json && chown $GUEST_USER:$GUEST_USER shell.json &&
      echo 'Widget registered in bar ($section section)'
    fi"

  cmd_restart_shell
  echo "Done. Check it with: omavm shot"
}

# Build the cidata drive that turns the ISO's wizard into an unattended
# install: the installer mounts any drive labelled CIDATA (cloud-init's NoCloud
# convention) and uses the files on it instead of asking. The layout below is
# archinstall's own config format; deliberately no "disk_encryption" block, so
# the installed system boots without a passphrase.
build_cidata() {
  local img="$1" dir hash
  dir=$(mktemp -d)

  hash=$(openssl passwd -6 "$GUEST_PASSWORD")

  local mib=$((1024 * 1024)) gib=$((1024 * 1024 * 1024))
  local disk_bytes=$((40 * gib))
  local boot_start=$mib boot_size=$((2 * gib))
  local main_start=$((boot_size + boot_start))
  local main_size=$((disk_bytes - main_start - mib)) # minus the GPT backup reserve

  cat >"$dir/user_credentials.json" <<EOF
{
    "root_enc_password": $(jq -Rn --arg v "$hash" '$v'),
    "users": [
        {
            "enc_password": $(jq -Rn --arg v "$hash" '$v'),
            "groups": [],
            "sudo": true,
            "username": "$GUEST_USER"
        }
    ]
}
EOF

  cat >"$dir/user_configuration.json" <<EOF
{
    "app_config": null,
    "archinstall-language": "English",
    "auth_config": {},
    "audio_config": { "audio": "pipewire" },
    "bootloader_config": { "bootloader": "Limine", "uki": false, "removable": false },
    "custom_commands": [],
    "omarchy_install": {
        "mode": "full_disk",
        "defer_provisioning": false,
        "target_mount": "/mnt",
        "boot": {
            "esp_mount": "/boot",
            "esp_path": "/EFI/limine",
            "efi_binary": "limine_x64.efi",
            "enable_fallback": true
        },
        "storage": {}
    },
    "disk_config": {
        "config_type": "default_layout",
        "device_modifications": [
            {
                "device": "/dev/vda",
                "partitions": [
                    {
                        "btrfs": [],
                        "dev_path": null,
                        "flags": [ "boot", "esp" ],
                        "fs_type": "fat32",
                        "mount_options": [],
                        "mountpoint": "/boot",
                        "obj_id": "ea21d3f2-82bb-49cc-ab5d-6f81ae94e18d",
                        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "B", "value": $boot_size },
                        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "B", "value": $boot_start },
                        "status": "create",
                        "type": "primary"
                    },
                    {
                        "btrfs": [
                            { "mountpoint": "/", "name": "@" },
                            { "mountpoint": "/home", "name": "@home" },
                            { "mountpoint": "/var/log", "name": "@log" },
                            { "mountpoint": "/var/cache/pacman/pkg", "name": "@pkg" }
                        ],
                        "dev_path": null,
                        "flags": [],
                        "fs_type": "btrfs",
                        "mount_options": [ "compress=zstd" ],
                        "mountpoint": null,
                        "obj_id": "8c2c2b92-1070-455d-b76a-56263bab24aa",
                        "size": { "sector_size": { "unit": "B", "value": 512 }, "unit": "B", "value": $main_size },
                        "start": { "sector_size": { "unit": "B", "value": 512 }, "unit": "B", "value": $main_start },
                        "status": "create",
                        "type": "primary"
                    }
                ],
                "wipe": true
            }
        ]
    },
    "hostname": "$GUEST_HOSTNAME",
    "network_config": { "type": "iso" },
    "ntp": true,
    "parallel_downloads": 8,
    "script": null,
    "services": [],
    "swap": true,
    "timezone": "$GUEST_TIMEZONE",
    "locale_config": { "kb_layout": "us", "sys_enc": "UTF-8", "sys_lang": "en_US.UTF-8" },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [
            {"url": "https://mirror.omarchy.org/\$repo/os/\$arch"},
            {"url": "https://mirror.rackspace.com/archlinux/\$repo/os/\$arch"},
            {"url": "https://geo.mirror.pkgbuild.com/\$repo/os/\$arch"}
        ],
        "mirror_regions": {},
        "optional_repositories": []
    },
    "packages": [
        "base-devel",
        "git",
        "omarchy-keyring",
        "omarchy-settings",
        "omarchy"
    ],
    "profile_config": { "gfx_driver": null, "greeter": null, "profile": {} },
    "version": "3.0.9"
}
EOF

  echo "$GUEST_FULL_NAME" >"$dir/user_full_name.txt"
  echo "$GUEST_EMAIL" >"$dir/user_email_address.txt"
  echo "false" >"$dir/user_encrypt_installation.txt"
  # Gets installed as the guest user's authorized_keys, and enables sshd plus a
  # ufw rule for it; without this the installed system is unreachable.
  cat "$HOME/.ssh/id_ed25519.pub" >"$dir/authorized_keys"

  rm -f "$img"
  truncate -s 4M "$img"
  mkfs.vfat -n CIDATA "$img" >/dev/null
  mcopy -i "$img" "$dir"/* ::/
  rm -rf "$dir"
}

# The highest version among the Omarchy ISOs in ~/Downloads, or nothing.
find_iso() {
  find "$HOME/Downloads" -maxdepth 1 -name 'omarchy-*.iso' 2>/dev/null | sort -V | tail -n 1
}

cmd_install() {
  check_host
  if domain_running; then
    echo "omavm: $DOMAIN is running; stop it first (omavm stop)." >&2
    exit 1
  fi
  if [[ -z $ISO ]]; then
    ISO=$(find_iso) || true
    if [[ -z $ISO ]]; then
      echo "omavm: no omarchy-*.iso in ~/Downloads" >&2
      echo "Download one from https://iso.omarchy.org/ or set OMAVM_ISO." >&2
      exit 1
    fi
  fi
  if [[ ! -f "$ISO" ]]; then
    echo "omavm: ISO not found at $ISO" >&2
    echo "Download one from https://iso.omarchy.org/ or set OMAVM_ISO." >&2
    exit 1
  fi
  for tool in mkfs.vfat mcopy jq openssl virt-install; do
    if ! command -v "$tool" >/dev/null; then
      echo "omavm: '$tool' is missing (mcopy comes from the mtools package)." >&2
      exit 1
    fi
  done

  # In libvirt's images directory too: the qemu libvirt starts must read the
  # ISO and the cidata drive as well as the disk.
  local iso="$IMAGES_DIR/$(basename "$ISO")" cidata="$IMAGES_DIR/$DOMAIN-cidata.img"
  [[ -f $iso ]] || cp "$ISO" "$iso"
  echo "Building the cidata drive (unattended, no disk encryption)"
  build_cidata "$cidata"

  echo "Creating a blank 40G disk and booting $(basename "$ISO")"
  remove_domain
  qemu-img create -q -f qcow2 "$DISK" 40G
  cp /usr/share/edk2/x64/OVMF_VARS.4m.fd "$VARS"
  # The blank disk boots first and falls through to the ISO; once installed
  # the same disk boots the real system, so no boot-order change is needed.
  define_domain \
    --disk "path=$DISK,format=qcow2,bus=virtio,boot.order=1" \
    --disk "path=$iso,device=cdrom,bus=sata,readonly=on,boot.order=2" \
    --disk "path=$cidata,format=raw,bus=usb,readonly=on"

  echo "Installing. This takes 15-30 minutes; 'omavm view' shows progress."
  echo "The guest reboots into the installed system on its own, and SSH"
  echo "answering is how we know it got there."
  wait_for_ssh "$GUEST_USER" 3600 10

  cmd_provision
  rm -f "$cidata"
  echo
  echo "Done. Save it as the clean snapshot with:"
  echo "  omavm stop && omavm save fresh --force"
}

# Everything that turns a stock install into the test machine we want. Split
# out from cmd_install so it can be re-run against an existing VM.
cmd_provision() {
  require_running
  local key
  key=$(cat "$HOME/.ssh/id_ed25519.pub")

  # One sudo for the whole lot. Piping the password in as the first line and
  # the script after it means sudo consumes the line it wants and bash reads
  # the rest, so this needs neither a tty nor a second authentication.
  #
  # Passwordless sudo afterwards: on a machine that already boots unattended
  # and hands out root over SSH, a sudo password guards nothing and only gets
  # in the way of scripts. NOPASSWD alone is not enough: the stock install also
  # writes a plain "ALL" rule, and against that "sudo -v" still demands a
  # password. omarchy-update runs exactly that, so it would stop and ask on a
  # machine meant to need no typing. !authenticate covers the validation too.
  #
  # Only the first run needs that password line. Once the sudoers drop-in below
  # is in place sudo asks for nothing and leaves the line unread, and bash then
  # runs the password itself as the first command of the script. So ask sudo
  # first whether it still wants one.
  echo "Opening the root SSH path and enabling passwordless sudo"
  local needs_password=1
  usermssh "sudo -n true" 2>/dev/null && needs_password=0
  {
    if ((needs_password)); then
      echo "$GUEST_PASSWORD"
    fi
    cat <<PROVISION
set -e
mkdir -p /root/.ssh
chmod 700 /root/.ssh
printf '%s\n' '$key' > /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys
printf '%s\n' 'Defaults:$GUEST_USER !authenticate' '$GUEST_USER ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/99-omavm
chmod 440 /etc/sudoers.d/99-omavm
visudo -c > /dev/null
PROVISION
  } | usermssh "sudo -S -p '' bash -s"

  # Without disk encryption the installer sets up no SDDM autologin, so the
  # machine still stops at a login prompt. That would defeat the point: this VM
  # has to come up ready to use without anyone typing anything.
  echo "Enabling SDDM autologin for $GUEST_USER"
  vmssh "cat > /etc/sddm.conf.d/99-omavm-autologin.conf <<EOF
[Autologin]
User=$GUEST_USER
Session=hyprland-uwsm.desktop
Relogin=true
EOF"

  # A test VM should never dim, lock or start a screensaver: that costs a
  # password prompt on a machine meant to need none, and a blanked screen also
  # hangs the grim screenshot in "omavm shot". Both toggles take an explicit
  # value, so re-running provision cannot flip them back off.
  echo "Disabling the screensaver and keeping the screen awake"
  vmssh "runuser -u $GUEST_USER -- bash -lc '
    omarchy-toggle screensaver-off on
    omarchy-toggle-idle stay-awake >/dev/null'" ||
    echo "omavm: could not set the idle toggles (old Omarchy?)" >&2

  # A fresh install has empty package databases: everything came from the
  # mirror bundled on the ISO, so pacman has never synced, and any install
  # fails with "target not found". This runs seconds after the first boot and
  # has failed there once for no reason it kept, so it gets a few tries, and
  # pacman's own words when it still fails. Still a failure then: a snapshot
  # saved with unsynced databases fails every later install in the guest.
  echo "Syncing package databases"
  local out="" try synced=0
  for try in 1 2 3; do
    if out=$(vmssh "pacman -Sy --noconfirm" 2>&1); then
      synced=1
      break
    fi
    ((try < 3)) && sleep 5
  done
  if ((!synced)); then
    echo "omavm: pacman -Sy failed in the guest:" >&2
    tail -n 5 <<<"$out" >&2
    echo "Run 'omavm provision' again once that is resolved." >&2
    return 1
  fi

  # The dotfiles are one person's setup, not part of the machine: without a
  # repo there is nothing to stow, and no reason to call the install failed.
  if [[ ! -d "$DOTFILES_REPO/.git" ]]; then
    echo "No dotfiles repo at $DOTFILES_REPO; skipping the dotfiles"
    return 0
  fi
  cmd_dotfiles
}

# Ship the dotfiles as a git clone of the host's working repo: a clone carries
# only tracked files, so the ignored private keys stay on the host. The origin
# is then pointed back at GitHub, reachable through a forwarded agent.
cmd_dotfiles() {
  require_running
  if [[ ! -d "$DOTFILES_REPO/.git" ]]; then
    echo "omavm: no git repo at $DOTFILES_REPO" >&2
    exit 1
  fi
  local staging out

  # Here rather than in provision, so a VM provisioned without dotfiles can
  # still take them later.
  echo "Installing stow"
  if ! out=$(vmssh "pacman -S --needed --noconfirm stow" 2>&1); then
    echo "omavm: could not install stow in the guest; dotfiles stay unstowed:" >&2
    tail -n 5 <<<"$out" >&2
    return 1
  fi

  staging=$(mktemp -d)

  echo "Cloning the dotfiles into the guest (tracked files only)"
  git clone --quiet --no-hardlinks "$DOTFILES_REPO" "$staging/dotfiles"
  git -C "$staging/dotfiles" remote set-url origin "$DOTFILES_ORIGIN"

  tar -C "$staging" -czf - dotfiles |
    vmssh "rm -rf ~$GUEST_USER/dotfiles && tar -C ~$GUEST_USER -xzf - && \
           chown -R $GUEST_USER:$GUEST_USER ~$GUEST_USER/dotfiles"
  rm -rf "$staging"

  # A stock Omarchy already ships files where the dotfiles want to put links
  # (nvim config, starship.toml), so a plain stow aborts on every one of them.
  # --adopt pulls those files into the repo and links them, which would leave
  # the repo holding Omarchy's defaults instead of ours; the checkout right
  # after throws that content away again. The links stay, the repo wins. Safe
  # here precisely because this is a throwaway clone with nothing local in it.
  echo "Stowing: $DOTFILES_PACKAGES"
  if vmssh "runuser -u $GUEST_USER -- bash -lc 'cd ~/dotfiles && \
              stow --adopt -t ~ $DOTFILES_PACKAGES && git checkout -- .'"; then
    echo "Dotfiles stowed"
  else
    echo "omavm: stow failed; look around with: omavm ssh" >&2
    return 1
  fi
}

# Run something in the guest with the host's SSH agent forwarded. The keys stay
# on the host: the guest can ask the agent to sign, never to hand over a key,
# and the moment this command returns that access is gone again. That is what
# keeps GitHub reachable from a VM whose disk has no encryption.
cmd_agent() {
  require_running
  if [[ ! -S "$AGENT_SOCK" ]]; then
    echo "omavm: no SSH agent socket at $AGENT_SOCK" >&2
    echo "Open 1Password (it provides the agent) or set OMAVM_AGENT_SOCK." >&2
    exit 1
  fi
  if ! SSH_AUTH_SOCK="$AGENT_SOCK" ssh-add -l >/dev/null 2>&1; then
    echo "omavm: the agent at $AGENT_SOCK holds no keys or refuses connections." >&2
    echo "Unlock 1Password and try again." >&2
    exit 1
  fi
  local opts=(-A -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR)
  if (($# == 0)); then
    SSH_AUTH_SOCK="$AGENT_SOCK" exec ssh "${opts[@]}" "$GUEST_USER@$IP"
  fi
  SSH_AUTH_SOCK="$AGENT_SOCK" ssh "${opts[@]}" "$GUEST_USER@$IP" "$@"
}

# Photograph the guest's screen through libvirt. Unlike "shot" this needs no
# SSH and no Wayland session in the guest, so it is the way to see an
# install, a boot prompt or a crash.
cmd_screendump() {
  if ! domain_running; then
    echo "omavm: $DOMAIN is not running." >&2
    exit 1
  fi
  local out="${1:-vm-screen.png}" raw
  raw=$(mktemp)
  virsh_ screenshot "$DOMAIN" "$raw" >/dev/null
  magick "$raw" "$out"
  rm -f "$raw"
  echo "$out"
}

# Press keys inside the guest through QEMU's own input layer. This is not
# synthetic input on the host: nothing is typed into the host's compositor and
# no window has to be focused, so it cannot disturb whatever Jankees is doing.
# Key names are QEMU's (ret, esc, spc, up, down, a-z, 0-9), and a
# dash-separated combination is sent as a chord: omavm sendkey ctrl-alt-f2
cmd_sendkey() {
  if ! domain_running; then
    echo "omavm: $DOMAIN is not running." >&2
    exit 1
  fi
  if (($# == 0)); then
    echo "omavm: usage: omavm sendkey <key> [key...]   (e.g. ret, ctrl-alt-f2)" >&2
    exit 1
  fi
  local key
  for key in "$@"; do
    if [[ ! $key =~ ^[a-z0-9_-]+$ ]]; then
      echo "omavm: '$key' is not a QEMU key name" >&2
      exit 1
    fi
    virsh_ qemu-monitor-command "$DOMAIN" --hmp "sendkey $key" >/dev/null
    sleep 0.2
  done
  echo "Sent: $*"
}

# Set the guest's mode for this session. The size it boots with comes from
# OMAVM_RES; this changes it on a running VM.
cmd_resolution() {
  require_running
  local spec="${1:-}" guest_scale="${2:-1}"
  if [[ ! $spec =~ ^([0-9]+)x([0-9]+)$ ]]; then
    echo "omavm: usage: omavm resolution <width>x<height> [guest-scale]" >&2
    echo "e.g. omavm resolution 1920x1080" >&2
    exit 1
  fi
  local output
  output=$(vmssh "$GUEST_ENV hyprctl -j monitors" 2>/dev/null | jq -r '.[0].name // empty')
  if [[ -z $output ]]; then
    echo "omavm: no Hyprland session in the guest yet; boot it first." >&2
    exit 1
  fi
  vmssh "$GUEST_ENV hyprctl eval 'hl.monitor({ output = \"$output\", mode = \"${spec}@60\", position = \"0x0\", scale = $guest_scale })'" >/dev/null
  echo "Guest $output -> $spec @ scale $guest_scale"
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  provision) shift; cmd_provision "$@" ;;
  dotfiles) shift; cmd_dotfiles "$@" ;;
  agent) shift; cmd_agent "$@" ;;
  boot) shift; cmd_boot "$@" ;;
  create) shift; cmd_create "$@" ;;
  # What "create" runs once OMAVM_NAME is set: boot, then the line scripts read.
  __create) shift; cmd_boot "$@"; printf '%s\t%s\n' "$DOMAIN" "$IP" ;;
  resume) shift; cmd_resume "$@" ;;
  stop) shift; cmd_stop "$@" ;;
  destroy) shift; cmd_destroy "$@" ;;
  status) shift; cmd_status "$@" ;;
  save) shift; cmd_save "$@" ;;
  list) shift; cmd_list "$@" ;;
  ssh) shift; cmd_ssh "$@" ;;
  user) shift; cmd_user "$@" ;;
  push) shift; cmd_push "$@" ;;
  pull) shift; cmd_pull "$@" ;;
  ip) shift; cmd_ip "$@" ;;
  shot) shift; cmd_shot "$@" ;;
  screendump) shift; cmd_screendump "$@" ;;
  view) shift; cmd_view "$@" ;;
  sendkey) shift; cmd_sendkey "$@" ;;
  hypr) shift; cmd_hypr "$@" ;;
  qs) shift; cmd_qs "$@" ;;
  restart-shell) shift; cmd_restart_shell "$@" ;;
  resolution) shift; cmd_resolution "$@" ;;
  plugin) shift; cmd_plugin "$@" ;;
  -h | --help | help | "") usage ;;
  *)
    echo "omavm: unknown command '$1'" >&2
    echo "Run 'omavm --help' for usage." >&2
    exit 1
    ;;
esac
